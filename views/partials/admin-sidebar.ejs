<aside class="cinetrack-sidebar d-flex flex-column flex-shrink-0 p-3">
    <a
        href="/admin"
        class="sidebar-brand d-flex align-items-center mb-3 text-decoration-none"
    >
        <img
            src="/images/cinetrack-icon.png"
            alt="CineTrack"
            width="40"
            height="40"
            class="me-2"
        >

        <span class="fs-4">Admin Panel</span>
    </a>

    <hr>

    <ul class="nav nav-pills flex-column mb-auto">

        <li class="nav-item">
            <a href="/admin/users" class="nav-link active">Manage Users</a>
        </li>

        <li>
            <a href="#" class="nav-link">Reports</a>
        </li>
    </ul>

    <hr>

    <div class="dropdown">
        <a
            href="#"
            class="sidebar-account d-flex align-items-center text-decoration-none dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
        >
            <div class="sidebar-avatar me-2">
                <%= user.username.charAt(0).toUpperCase() %>
            </div>

            <strong><%= user.username %></strong>
        </a>

        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li>
                <a class="dropdown-item" href="/">Return to CineTrack</a>
            </li>

            <li>
                <hr class="dropdown-divider">
            </li>

            <li>
                <form action="/auth/sign-out?_method=DELETE" method="POST">
                    <button class="dropdown-item" type="submit" style="color: rgb(202, 18, 18);">Sign out</button>
                </form>
            </li>
        </ul>
    </div>
</aside>