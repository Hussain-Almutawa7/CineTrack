<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CineTrack</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>

    <!-- My CSS -->
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/cinetrack-icon.png">
</head>

<body>
    <nav class="site-nav">
        <a class="site-nav-brand" href="/">
            <img src="/images/cinetrack-icon.png" alt="CineTrack logo">

            <span class="site-nav-name">
                <span class="cine-text">Cine</span><span class="track-text">Track</span>
            </span>
        </a>

        <form class="site-nav-search" action="/browse" method="GET">
            <input type="search" name="search" placeholder="Search movies and TV shows" required>
            <button class="primary-button" type="submit">Search</button>
        </form>

        <div class="site-nav-links">
            <a class="site-nav-link" href="/">Home</a>
            <a class="site-nav-link" href="/browse">Browse</a>

            <% if (user) { %>
                <a class="site-nav-link" href="/watchlist">Watchlist</a>

                    <div class="dropdown">
                        <a
                            href="#"
                            class="sidebar-account d-flex align-items-center text-decoration-none dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                            <div class="sidebar-avatar me-2">
                                <%= user.username.charAt(0).toUpperCase() %>
                            </div>

                            <strong><%= user.username %></strong>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <a class="dropdown-item" href="/user/<%= user.id %>">Your Profile</a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <% if(user.role === "admin") { %>
                                    <a class="dropdown-item" href="/admin/users">Admin Panel</a>
                                <% } %>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <form action="/auth/sign-out?_method=DELETE" method="POST">
                                    <button class="dropdown-item" type="submit">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                <% } else { %>
                    <a class="site-nav-link" href="/auth/sign-up">Sign Up</a>
                    <a class="site-nav-link" href="/auth/sign-in">Sign In</a>
                    <% } %>
        </div>
    </nav>